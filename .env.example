# Copy to .env. Everything here is optional: the dashboard and every question in
# the demo script are answered by the deterministic analyzer with no AI backend.
# Do not commit .env.

# --- Which backend(s) to use -------------------------------------------------
#   auto (default) : Anthropic when ANTHROPIC_API_KEY is set, else local Ollama.
#                    If an Anthropic call fails, it falls back to Ollama
#                    automatically for the same request.
#   anthropic      : Anthropic only, no fallback.
#   ollama         : local model only (nothing leaves the machine).
#   openai         : legacy OpenAI path.
#   none           : disable AI narrative entirely.
LLM_PROVIDER=auto

# --- Anthropic (primary) -----------------------------------------------------
# Create a key at https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# claude-opus-5 is the current Opus: $5 / $25 per million input / output tokens.
# claude-sonnet-5 is cheaper ($3 / $15) and also strong here.
ANTHROPIC_MODEL=claude-opus-5

# Thinking depth. The analyzer computes every number, so the model only phrases
# facts it was handed - low is sufficient and keeps the demo responsive.
# One of: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# Caps thinking + response text together.
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=3

# --- Ollama (local fallback) -------------------------------------------------
# qwen3:4b is the recommended model for a 6 GB GPU such as a Radeon RX 5600M.
#   ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b

# Leave blank to auto-detect: 127.0.0.1:11434 first, then a WSL NAT gateway.
# WSL2 cannot reach an AMD GPU (no /dev/kfd), so run Ollama on Windows. With
# networkingMode=mirrored in .wslconfig, 127.0.0.1 already reaches Windows and
# this can stay blank. On default NAT networking, set it explicitly:
#   OLLAMA_HOST=http://172.28.0.1:11434
OLLAMA_HOST=

# 8192 fits qwen3:4b inside 6 GB VRAM. Raising it pushes layers onto the CPU.
OLLAMA_NUM_CTX=8192

# Output cap. qwen3 writes long reasoning preambles; without this a single
# answer can take minutes at ~7 tokens/sec.
OLLAMA_NUM_PREDICT=400

OLLAMA_TIMEOUT=300
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.2

# --- OpenAI (only when LLM_PROVIDER=openai) ----------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
